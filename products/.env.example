# =============================================================================
# Variáveis do products. Copie para .env (gitignored): cp .env.example .env
# No cluster: PORT vem dos values do repo de infra
# (projects/nest-rabbitmq/apps/products/values.yaml) e as credenciais do
# RabbitMQ do Secret `rabbitmq`, criado pela plataforma (make seal).
# =============================================================================

PORT=3000

# RabbitMQ local (docker compose da pasta raiz)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
